# Copia questo file in .env e compila con le tue credenziali Firebase
# Crea il progetto su https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=inserisci_qui
VITE_FIREBASE_AUTH_DOMAIN=inserisci_qui.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=inserisci_qui
VITE_FIREBASE_STORAGE_BUCKET=inserisci_qui.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=inserisci_qui
VITE_FIREBASE_APP_ID=inserisci_qui

# EmailJS – crea account gratuito su emailjs.com
VITE_EMAILJS_SERVICE_ID=inserisci_qui
VITE_EMAILJS_TEMPLATE_ID=inserisci_qui
VITE_EMAILJS_PUBLIC_KEY=inserisci_qui

# Email del ristorante per notifiche
VITE_RESTAURANT_EMAIL=info@trattoriabarcantone.it
