rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Legge il ruolo dell'utente da Firestore
    function getUserRole() {
      let doc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
      return doc != null ? doc.data.role : null;
    }

    // Permette l'accesso a Owner e Manager (lo Staff non gestisce immagini)
    function isManager() {
      return request.auth != null && getUserRole() in ['OWNER', 'MANAGER'];
    }
    
    // Verifica se il file è un'immagine supportata e pesa meno di 5MB
    function isValidImage() {
      return request.resource.contentType.matches('image/jpeg|image/png|image/webp')
          && request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      // Lettura pubblica
      allow read: if true;
      
      // Creazione/Aggiornamento limitato a Manager/Owner e con validazione formato/peso
      allow create, update: if isManager() && isValidImage();
      
      // Eliminazione libera per Manager/Owner
      allow delete: if isManager();
    }
  }
}
